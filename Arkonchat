local function filterText(t)
    t=tostring(t or "")
    if getgenv().ArkFilter==false then return t end
    local low=t:lower()
    for _,w in ipairs(BANNED_WORDS) do
        w=tostring(w):lower()
        if w~="" then
            local i=1
            while true do
                local s,e=low:find(w,i,true)
                if not s then break end
                local stars=string.rep("*",e-s+1)
                t=t:sub(1,s-1)..stars..t:sub(e+1)
                low=low:sub(1,s-1)..stars..low:sub(e+1)
                i=e+1
            end
        end
    end
    return t
end

