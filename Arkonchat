    -- v7.7: إعادة رسم كل الرسائل (للبحث) + البحث + إكمال المنشن
    local function refreshAllMessages()
        if not scroll or not scroll.Parent then return end
        for _,ch in ipairs(scroll:GetChildren()) do if ch:IsA("Frame") then ch:Destroy() end end
        msgIdx=0
        for _,m in ipairs(caches[currentRoom]) do renderMessage(m,true) end
