    -- إكمال المنشن
    local sugBar=Instance.new("Frame")
    sugBar.Size=UDim2.new(1,-70,0,24); sugBar.Position=UDim2.new(0,62,1,-104)
    sugBar.BackgroundTransparency=1; sugBar.Visible=false; sugBar.ZIndex=20; sugBar.Parent=win
    local sbl=Instance.new("UIListLayout",sugBar)
    sbl.FillDirection=Enum.FillDirection.Horizontal; sbl.Padding=UDim.new(0,4)

    local function updateSuggestions()
        for _,c in ipairs(sugBar:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
        local partial=inputBox.Text:match("@([%w_]*)$")
        if not partial then sugBar.Visible=false; return end
        local names,seen={},{}
        local function consider(n,uid)
            n=tostring(n or "")
            if n=="" or seen[n] or n==LocalPlayer.Name or n=="ArkonBot" then return end
            if n:lower():sub(1,#partial)~=partial:lower() then return end
            local pc=uid and privacyCache[tostring(uid)]
            if pc and pc.private then return end
            seen[n]=true; table.insert(names,n)
        end
        local list=caches[currentRoom]
        for i=#list,1,-1 do
            local e=list[i]
            if not e.isMe and not e.isSystem then consider(e.sender,e.userId) end
            if #names>=4 then break end
        end
        for _,f in ipairs(friendsCache.list) do consider(f.name,f.id) end
        for i=1,math.min(4,#names) do
            local n=names[i]
            local b=Instance.new("TextButton")
            b.Size=UDim2.new(0,0,0,22); b.AutomaticSize=Enum.AutomaticSize.X
            b.BackgroundColor3=C.bg3; b.TextColor3=C.text; b.Font=Enum.Font.GothamBold; b.TextSize=10
            b.Text=" @"..n.." "; b.AutoButtonColor=false; b.ZIndex=21; b.Parent=sugBar
            corner(b,6); stroke(b,C.accent,1,0.5)
            b.Activated:Connect(function()
                inputBox.Text=inputBox.Text:gsub("@([%w_]*)$","@"..n.." ")
                pcall(function() inputBox:CaptureFocus() end)
            end)
        end
        sugBar.Visible=(#names>0)
    end
    inputBox:GetPropertyChangedSignal("Text"):Connect(function() pcall(updateSuggestions) end)

    task.spawn(function()
        local fakeMessages = {
            "Welcome to Arkonchat! Feel free to chat.",
            "Did you know you can talk to AI by clicking the 🤖 icon?",
            "Need help? Ask an admin or helper.",
            "Trading is open! Be careful of scammers.",
            "Arkonchat v7.8 is now live! Reactions, replies, status and more.",
