    getgenv().ArkChatClear = function()
        caches.general={}; caches.trading={}
        if scroll and scroll.Parent then
            for _,ch in ipairs(scroll:GetChildren()) do if ch:IsA("Frame") then ch:Destroy() end end
        end
        msgIdx=0
    end

    getgenv().ArkChatRefresh = function()
        if not scroll or not scroll.Parent then return end
        for _,ch in ipairs(scroll:GetChildren()) do if ch:IsA("Frame") then ch:Destroy() end end
        msgIdx=0
        for _,m in ipairs(caches[currentRoom]) do
            seenIds[currentRoom][m.id]=true
            renderMessage(m,true)
        end
    end

    local function pollRoom(roomKey)
        if not polling then return end
        local data=chatRead(Key,roomKey,lastIds[roomKey])
        if not data or not data.messages then return end
        local first=lastIds[roomKey]==nil
        for _,m in ipairs(data.messages) do
            if not first and m.from_user_id~=LocalPlayer.UserId and not isMutedByMe(m.from_user_id) and not (getgenv().MyProfile.blockDMs==true and m.to_user_id~=nil) then
                local rx,rk=tostring(m.message or ""):match("^{{x|([^|]*)|([^}]*)}}$")
                if rx then
                    addReaction(rk,rx)   -- ريأكشن: ما يطلع كرسالة
                else
                    local entry={
                        id=tostring(m.id or m.created_at or os.time()).."_"..tostring(m.from_user_id),
                        sender=m.from_username,userId=m.from_user_id,text=m.message,
                        isDM=m.to_user_id~=nil,isMe=false,isSystem=false,
                        statusText=m.saved and "Saved" or "Delivered",
                    }
                    table.insert(caches[roomKey],entry)
                    playPing()
                    if not (win.Visible and roomKey==currentRoom) then
                        unread=unread+1
                        if not isDND() then updateBadge(true) end
                    end
                    if roomKey==currentRoom then
                        seenIds[currentRoom][entry.id]=true
                        renderMessage(entry)
                    end
                end
            end
        end
        if data.last_message_id then lastIds[roomKey]=data.last_message_id end
    end

    local function doSend()
        local text=inputBox.Text
        if not text or text=="" then return end
        if utf8.len(text) and utf8.len(text)>MAX_MSG_LEN then text=string.sub(text,1,MAX_MSG_LEN) end
        -- v7.7: منع السبام + فلتر الكلمات + الرد
        do
            local now=tick()
            if now-lastSendAt<MIN_SEND_GAP then
                showToast("Slow down","Wait a moment before sending again",{color=C.err,duration=2}); return
            end
            if getgenv().ArkFilter~=false and text==lastSendText and now-lastSendAt<10 then
                showToast("Spam","Don't repeat the same message",{color=C.err,duration=2}); return
            end
            lastSendAt=now; lastSendText=text
        end
        text=filterText(text)
        if replyTarget then
            text="{{r|"..clean(replyTarget.sender).."|"..clean(replyTarget.text).."}} "..text
            setReply(nil)
        end
        local toId=tonumber(toBox.Text)
        local sendRoom=currentRoom
        inputBox.Text=""
        pcall(function() writeTyping(false) end)
        task.defer(function() pcall(function() inputBox:CaptureFocus() end) end)
        local entry={
            id=tostring(os.time()).."_"..LocalPlayer.UserId.."_"..math.random(1000,9999),
            sender=LocalPlayer.Name,userId=LocalPlayer.UserId,text=text,
            isDM=toId~=nil,toUserId=toId,isMe=true,statusText="Sending...",
        }
        local statusRef=renderMessage(entry)
        seenIds[currentRoom][entry.id]=true
        table.insert(caches[currentRoom],entry)
        task.spawn(function()
            local ok,err=chatSend(Key,toId,text,sendRoom,false)
            entry.statusText=ok and "Sent" or ("Failed: "..tostring(err))
            if statusRef and statusRef.Parent then
                if ok then statusRef.Text="Sent"; statusRef.TextColor3=C.accent
                else statusRef.Text="Failed: "..tostring(err); statusRef.TextColor3=C.err end
            end
        end)
    end
    sendBtn.Activated:Connect(doSend)

    inputBox.FocusLost:Connect(function(e)
        pcall(function() writeTyping(false) end)
        if e then doSend() end
    end)
    inputBox:GetPropertyChangedSignal("Text"):Connect(function()
        if inputBox.Text ~= "" then
            pcall(function() writeTyping(true) end)
        else
            pcall(function() writeTyping(false) end)
        end
    end)

    task.spawn(function()
        while polling do
            pcall(pollRoom,"general")
            task.wait(POLL_SEC/2)
            pcall(pollRoom,"trading")
            task.wait(POLL_SEC/2)
        end
    end)
end

-- [FIX 5] wrap startChat so any error is printed + copied to clipboard instead of dying silently
_G.__startChat=function(Key)
    local ok,err=xpcall(function() startChatInner(Key) end,function(e)
        return tostring(e).."\n"..debug.traceback()
    end)
    if not ok then
        warn("[ARKONCHAT ERROR] "..tostring(err))
        if setclipboard then pcall(setclipboard,tostring(err)) end
        showToast("Arkonchat Error","Error copied to clipboard",{color=C.err,duration=6})
    else
        task.spawn(function() task.wait(1); pcall(checkReturnPrompt) end)
    end
end

