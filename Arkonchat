local function calcAge(iso)
    if not iso then return "?" end
    local y,mo,d=iso:match("(%d+)-(%d+)-(%d+)"); if not y then return "?" end
    y,mo,d=tonumber(y),tonumber(mo),tonumber(d)
    local now=os.date("*t"); local yy,mm=now.year-y,now.month-mo
    if now.day<d then mm=mm-1 end
    if mm<0 then yy=yy-1; mm=mm+12 end
    if yy>0 then return yy.."y "..mm.."m" end
    return mm.."m"
end
local function formatLastSeen(ts)
    if not ts then return "?" end
    local diff=os.time()-ts
    if diff<60 then return "just now"
    elseif diff<3600 then return math.floor(diff/60).."m ago"
    elseif diff<86400 then return math.floor(diff/3600).."h ago"
    else return math.floor(diff/86400).."d ago" end
end

local function makeDraggable(win,dragArea)
    local area=dragArea or win
    area.Active=true; win.Active=true
    local dragging=false; local dragStart,startPos=nil,nil
    area.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            dragging=true; dragStart=input.Position; startPos=win.Position
        end
    end)
    area.InputEnded:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            dragging=false; dragStart=nil; startPos=nil
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and dragStart and startPos then
            if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then
                local delta=input.Position-dragStart
                win.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,startPos.Y.Scale,startPos.Y.Offset+delta.Y)
            end
        end
    end)
end

