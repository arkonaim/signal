    local s0,p0=frame.Size,frame.Position
    if frame.AnchorPoint==Vector2.new(0,0) then
        frame.AnchorPoint=Vector2.new(0.5,0.5)
        frame.Position=UDim2.new(p0.X.Scale,p0.X.Offset+s0.X.Offset/2,p0.Y.Scale,p0.Y.Offset+s0.Y.Offset/2)
    end
