local MAX_FRIENDS=100
local friendsCache={list={},_ts=0}

local function getFriends(force)
    if not force and (tick()-friendsCache._ts)<20 then return friendsCache.list end
    local d=vaultRead("friends_"..tostring(LocalPlayer.UserId))
    friendsCache.list=(d and type(d.list)=="table" and d.list) or {}
    friendsCache._ts=tick()
    return friendsCache.list
end
local function isFriend(userId)
    for _,f in ipairs(getFriends()) do
        if tonumber(f.id)==tonumber(userId) then return true end
    end
    return false
end
-- يكتب إشعار في صندوق الشخص اللي انضاف
local function notifyFriendAdded(targetId)
    local key="friendnotif_"..tostring(targetId)
    local d=vaultRead(key)
    local items=(d and type(d.items)=="table" and d.items) or {}
    table.insert(items,{
        id=tostring(os.time()).."_"..tostring(LocalPlayer.UserId).."_"..tostring(math.random(1000,9999)),
        fromId=LocalPlayer.UserId,fromName=LocalPlayer.Name,at=os.time()
    })
    while #items>30 do table.remove(items,1) end
    vaultSave(key,{items=items})
end
local function addFriend(userId,name)
    userId=tonumber(userId)
    if not userId or userId<=0 then return false,"Invalid user" end
    if userId==LocalPlayer.UserId then return false,"You can't add yourself" end
    if userId==AI_BOT_USER_ID then return false,"You can't add the bot" end
    local list=getFriends(true)
    for _,f in ipairs(list) do
        if tonumber(f.id)==userId then return false,"Already your friend" end
    end
    if #list>=MAX_FRIENDS then return false,"Friend list is full" end
    table.insert(list,{id=userId,name=tostring(name or userId),at=os.time()})
    friendsCache.list=list; friendsCache._ts=tick()
    if not vaultSave("friends_"..tostring(LocalPlayer.UserId),{list=list}) then return false,"Could not save" end
    task.spawn(function() pcall(notifyFriendAdded,userId) end)
    return true
end
local function removeFriend(userId)
    local list=getFriends(true); local newList={}
    for _,f in ipairs(list) do
        if tonumber(f.id)~=tonumber(userId) then table.insert(newList,f) end
    end
    friendsCache.list=newList; friendsCache._ts=tick()
    return vaultSave("friends_"..tostring(LocalPlayer.UserId),{list=newList})
end
-- ناس ضافوني وأنا ما ضفتهم
local function getAddedMe()
    local d=vaultRead("friendnotif_"..tostring(LocalPlayer.UserId))
    local out,seen={},{}
    if d and type(d.items)=="table" then
        for i=#d.items,1,-1 do
            local it=d.items[i]; local id=tonumber(it.fromId)
            if id and not seen[id] and not isFriend(id) then
                seen[id]=true
                table.insert(out,{id=id,name=tostring(it.fromName or id)})
            end
        end
    end
    return out
end

