        end
        local names = {}
        for _, u in ipairs(users) do table.insert(names, u.name) end
        local txt
        if #users == 1 then
            if users[1].name == "You" then txt = "You are typing..."
            else txt = users[1].name .. " is typing..." end
        else
            txt = table.concat(names, ", ") .. " are typing..."
        end
        typingLabel.Text = txt
        typingLabel.Visible = true
    end

