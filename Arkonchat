    local searchQuery=""
    local replyTarget=nil
    local reactions={}      -- key -> {emoji=count}
    local reactLabels={}    -- key -> {labels}
    local lastSendAt,lastSendText=0,""

    local function hashText(t)
        local h=0
        for i=1,#t do h=(h*31+t:byte(i))%1000003 end
        return h
    end
    local function clean(s)
        s=tostring(s or ""):gsub("[{}|\n]"," ")
        local n=utf8.len(s)
        if n and n>40 then s=s:sub(1,utf8.offset(s,41)-1) end
        return s
    end
    local function reactText(key)
        local t=reactions[key]
        if not t then return "" end
        local parts={}
        for em,n in pairs(t) do table.insert(parts,em.." "..n) end
        table.sort(parts)
        return table.concat(parts,"   ")
    end
    local function refreshReact(key)
        local txt=reactText(key)
        local labels=reactLabels[key] or {}
        for i=#labels,1,-1 do
            local l=labels[i]
            if l.Parent then l.Text=txt; l.Visible=(txt~="")
            else table.remove(labels,i) end
        end
    end
    local function addReaction(key,em)
        reactions[key]=reactions[key] or {}
        reactions[key][em]=(reactions[key][em] or 0)+1
