local function vaultSave(key,value)
    local ok,res=pcall(httpRequest,{Url=VAULT_URL,Method="POST",Headers={["Content-Type"]="application/json",["x-api-key"]=VAULT_KEY},Body=HttpService:JSONEncode({key=key,value=value})})
