        }
        while polling do
            task.wait(math.random(120, 240))
            local msg = fakeMessages[math.random(1, #fakeMessages)]
            local entry = {
                id="bot_"..tostring(os.time()), sender="ArkonBot", userId=1,
                text=msg, isMe=false, isSystem=true, statusText=""
            }
