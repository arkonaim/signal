local function checkReturnPrompt()
    local rp=readReturnPoint()
    if not rp then return end
    if tonumber(rp.placeId)==game.PlaceId and tostring(rp.jobId or "")==tostring(game.JobId or "") then
        clearReturnPoint(); return -- رجعت لنفس السيرفر
    end
    if rp.at and (os.time()-(tonumber(rp.at) or 0))>6*3600 then clearReturnPoint(); return end
    if rp.dismissed==true then return end
    showReturnPrompt(rp)
end

