local function countryFlag(code)
    if not code or #code~=2 then return "" end
    local base=0x1F1E6; local flag=""
    for i=1,2 do
        local c=string.byte(code:upper(),i)-64
        if c<1 or c>26 then return "" end
        flag=flag..utf8.char(base+c-1)
    end
    return flag
end
local function measureText(text,fontSize,maxWidth)
    local ok,sz=pcall(function() return TextService:GetTextSize(text,fontSize,Enum.Font.Gotham,Vector2.new(maxWidth,10000)) end)
    if ok and sz then return sz.Y end
    local chars=#tostring(text or "")
    local lines=math.ceil(chars/math.max(1,math.floor(maxWidth/(fontSize*0.55))))
    return math.max(16,lines*fontSize+6)
end

