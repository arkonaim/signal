-- ═══════════════════════════════════════════
--  JOIN / RETURN SYSTEM
--  Join   : ادخل لعبة شخص من بروفايله (إذا ما قفل الدخول)
--  Return : يرجعك لعبتك اللي كنت فيها قبل ما تنضم
-- ═══════════════════════════════════════════
local RETURN_FILE="ArkonReturn_"..tostring(LocalPlayer.UserId)..".json"

local function readReturnPoint()
    local data=nil
    if isfile and readfile then
        pcall(function()
            if isfile(RETURN_FILE) then data=HttpService:JSONDecode(readfile(RETURN_FILE)) end
        end)
    end
    if type(data)~="table" then
        local cloud=vaultRead("return_"..tostring(LocalPlayer.UserId))
        if type(cloud)=="table" then data=cloud end
    end
    if type(data)~="table" then return nil end
    local pid=tonumber(data.placeId)
    if not pid or pid<=0 then return nil end
    return data
end
local function writeReturnPoint(data)
    if writefile then pcall(writefile,RETURN_FILE,HttpService:JSONEncode(data)) end
    vaultSave("return_"..tostring(LocalPlayer.UserId),data)
end
local function saveReturnPoint()
    local data={placeId=game.PlaceId,jobId=game.JobId or "",name=getGameName(),at=os.time()}
    writeReturnPoint(data)
    return data
end
local function clearReturnPoint()
    writeReturnPoint({placeId=0,clearedAt=os.time()})
end

local function queueReload()
    if SCRIPT_URL=="" then return end
    local q=queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
    if q then pcall(q,'loadstring(game:HttpGet("'..SCRIPT_URL..'"))()') end
end

local function teleportToServer(placeId,jobId,onFail)
    placeId=tonumber(placeId)
    if not placeId or placeId<=0 then return false,"Invalid place" end
    queueReload()
    local failConn
    failConn=TeleportService.TeleportInitFailed:Connect(function(plr,result,msg)
        if plr~=LocalPlayer then return end
        if failConn then failConn:Disconnect() end
        if onFail then onFail(tostring(msg or result)) end
    end)
    task.delay(20,function() if failConn then pcall(function() failConn:Disconnect() end) end end)
    local ok,err
    if jobId and tostring(jobId)~="" then
        ok,err=pcall(function() TeleportService:TeleportToPlaceInstance(placeId,tostring(jobId),LocalPlayer) end)
    else
        ok,err=pcall(function() TeleportService:Teleport(placeId,LocalPlayer) end)
    end
    if not ok then
        if failConn then failConn:Disconnect() end
        return false,tostring(err)
    end
    return true
end

local function joinUserGame(prof,who)
    if not prof then showToast("Join","No game info for this user",{color=C.err,duration=3}); return end
    if prof.private==true or prof.hideGame==true or prof.hideJoin==true then
        showToast("Join hidden","This user doesn't allow joining",{color=C.err,duration=3}); return
    end
    local pid=tonumber(prof.placeId)
    local jid=tostring(prof.jobId or "")
    if not pid or pid<=0 or jid=="" then
        showToast("Join","No game info yet. Ask them to press Sync Map.",{color=C.err,duration=4}); return
    end
    if pid==game.PlaceId and jid==tostring(game.JobId) then
        showToast("Join","You are already in the same server",{color=C.dm,duration=3}); return
    end
    if prof.lastSeen and (os.time()-(tonumber(prof.lastSeen) or 0))>300 then
        showToast("Join","This user seems offline",{color=C.err,duration=3}); return
    end
    saveReturnPoint()
    showToast("Joining","Teleporting to "..tostring(who).."...",{color=C.accent,duration=3})
    local ok,err=teleportToServer(pid,jid,function(msg)
        clearReturnPoint()
        showToast("Join failed",tostring(msg),{color=C.err,duration=4})
    end)
    if not ok then
        clearReturnPoint()
        showToast("Join failed",tostring(err),{color=C.err,duration=4})
    end
end

local function returnToMyGame(rp)
    rp=rp or readReturnPoint()
    if not rp then showToast("Return","No saved game to return to",{color=C.err,duration=3}); return end
    local pid=tonumber(rp.placeId)
    showToast("Returning","Going back to "..tostring(rp.name or "your game").."...",{color=C.accent,duration=3})
    local ok,err=teleportToServer(pid,rp.jobId,function(msg)
        -- السيرفر القديم انقفل: افتح سيرفر جديد من نفس اللعبة
        showToast("Server closed","Opening a new server of your game...",{color=C.dm,duration=3})
        clearReturnPoint()
        teleportToServer(pid,"",nil)
    end)
    if not ok then showToast("Return failed",tostring(err),{color=C.err,duration=4}) end
end

