end
local function vaultRead(key)
    local ok,res=pcall(httpRequest,{Url=VAULT_URL.."?key="..HttpService:UrlEncode(key),Method="GET",Headers={["x-api-key"]=VAULT_KEY}})
    if not ok or not res then return nil end
    if res.StatusCode and res.StatusCode>=400 then return nil end
    local okD,d=pcall(function() return HttpService:JSONDecode(res.Body) end)
    return (okD and d) and d.value or nil
end

-- TTS Feature (multi-format + Google fallback + clear errors)
local function b64decode(data)
    local b='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
    data=string.gsub(data,'[^'..b..'=]','')
    return (data:gsub('.',function(x)
        if x=='=' then return '' end
        local r,f='',(b:find(x,1,true)-1)
        for i=6,1,-1 do r=r..(f%2^i-f%2^(i-1)>0 and '1' or '0') end
        return r
    end):gsub('%d%d%d?%d?%d?%d?%d?%d?',function(x)
        if #x~=8 then return '' end
        local c=0
        for i=1,8 do c=c+(x:sub(i,i)=='1' and 2^(8-i) or 0) end
        return string.char(c)
    end))
end
local function detectLang(text)
    if text:find("[\216-\219]") then return "ar" end
    return "en"
end
local function ttsFetchAudio(text,lang)
    local errMsg="unknown"
    local ok,res=pcall(httpRequest,{
        Url=TTS_API_URL,Method="POST",
        Headers={["Content-Type"]="application/json",["x-api-key"]=VAULT_KEY},
        Body=HttpService:JSONEncode({text=text,sender=LocalPlayer.Name,lang=lang})
    })
    if ok and res then
        local code=res.StatusCode or 200
        local body=res.Body or ""
        local ctype=""
        if res.Headers then
            for k,v in pairs(res.Headers) do
                if tostring(k):lower()=="content-type" then ctype=tostring(v):lower() end
            end
        end
        if code<400 then
            if ctype:find("audio") and #body>100 then return body end
            local okD,data=pcall(function() return HttpService:JSONDecode(body) end)
            if okD and type(data)=="table" then
                if type(data.data)=="table" then data=data.data end
                local b64=data.audio_base64 or data.audio_b64 or data.base64
                if not b64 and type(data.audio)=="string" and #data.audio>200 and not data.audio:find("^http") then b64=data.audio end
                if b64 then
                    local raw=b64decode((tostring(b64):gsub("^data:audio/[%w%-]+;base64,","")))
                    if raw and #raw>100 then return raw end
                end
                local url=data.audio_url or data.audioUrl or data.url
                if not url and type(data.audio)=="string" and data.audio:find("^http") then url=data.audio end
                if url then
                    if url:sub(1,1)=="/" then url="https://block-world-data-vault.lovable.app"..url end
                    local aOk,aRes=pcall(httpRequest,{Url=url,Method="GET"})
                    if aOk and aRes and aRes.Body and #aRes.Body>100 and (not aRes.StatusCode or aRes.StatusCode<400) then
                        return aRes.Body
                    end
                    errMsg="audio download failed"
                else
                    errMsg=tostring(data.error or data.message or ("no audio in response: "..body:sub(1,80)))
                end
            else errMsg="response is not JSON: "..body:sub(1,60) end
        else errMsg="HTTP "..tostring(code) end
    else errMsg="network error" end

    -- fallback: Google TTS
    local gUrl="https://translate.google.com/translate_tts?ie=UTF-8&client=tw-ob&tl="..lang.."&q="..HttpService:UrlEncode(text:sub(1,200))
    local gOk,gRes=pcall(httpRequest,{Url=gUrl,Method="GET",Headers={["User-Agent"]="Mozilla/5.0"}})
    if gOk and gRes and gRes.Body and #gRes.Body>100 and (not gRes.StatusCode or gRes.StatusCode<400) then
        return gRes.Body
    end
    return nil,errMsg
end
local ttsBusy=false
local function playTTSMessage(text)
    if not text or text=="" then return end
    local getAsset=getcustomasset or getsynasset
    if not writefile or not getAsset then
        showToast("TTS Unsupported","Your executor has no writefile/getcustomasset, so it can't play custom audio.",{color=C.err,duration=5})
        return
    end
    if ttsBusy then return end
    ttsBusy=true
    showToast("TTS","Generating voice...",{color=C.accent,duration=2})
    local audio,err=ttsFetchAudio(text,detectLang(text))
    if not audio then
        ttsBusy=false
        warn("[Arkonchat TTS] "..tostring(err))
        showToast("TTS Error",tostring(err),{color=C.err,duration=5})
        return
    end
    local fileName="ArkonTTS_"..tostring(math.random(100000,999999))..".mp3"
    local wOk=pcall(writefile,fileName,audio)
    if not wOk then ttsBusy=false; showToast("TTS Error","Could not write audio file.",{color=C.err,duration=4}) return end
    local success,assetPath=pcall(getAsset,fileName)
    if not success or not assetPath then ttsBusy=false; showToast("TTS Error","Could not load audio asset.",{color=C.err,duration=4}) return end
    local sound=Instance.new("Sound")
    sound.SoundId=assetPath; sound.Volume=1
    sound.Parent=SoundService
    sound.Ended:Connect(function() sound:Destroy(); if delfile then pcall(delfile,fileName) end end)
    local okP=pcall(function() sound:Play() end)
    ttsBusy=false
    if not okP then showToast("TTS Error","Playback failed.",{color=C.err,duration=4}) end
    task.delay(90,function() if sound and sound.Parent then sound:Destroy() end end)
end

