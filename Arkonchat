                e.Text="No friends yet. Add someone by username."; e.ZIndex=131; e.Parent=scroll
            else
                for _,f in ipairs(friends) do makeRow(f.id,f.name,false) end
            end
        end)
    end

    local adding=false
    local function doAdd()
        if adding then return end
        local name=addBox.Text:gsub("%s+","")
        if name=="" then showToast("Friends","Enter a username",{color=C.err,duration=2}); return end
        adding=true; addBtn.Text="..."
        task.spawn(function()
            local uid,realName=lookupUserId(name)
            if not uid then
                showToast("Friends","User not found",{color=C.err,duration=3})
            else
                local ok,err=addFriend(uid,realName or name)
                if ok then
