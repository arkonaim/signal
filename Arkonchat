-- [FIX 6] الوضع: يحدّث الواجهة فوراً (الكرت + النقطة + النص) والشبكة تشتغل بالخلفية
cycleStatus=function()
    local idx=1
    for i,s in ipairs(STATUSES) do if s[1]==getgenv().ArkStatus then idx=i end end
    idx=(idx % #STATUSES)+1
    getgenv().ArkStatus=STATUSES[idx][1]
    saveSettings()
    if getgenv().ArkRefreshStatus then pcall(getgenv().ArkRefreshStatus) end
    task.spawn(function() pcall(function() heartbeatOnline(getCurrentMapInfo().map) end) end)
    showToast("My status",STATUSES[idx][2],{color=STATUSES[idx][3],duration=2})
    return STATUSES[idx]
end

cycleDND=function()
    local cur=0
    if isDND() then cur=math.ceil((getgenv().ArkDNDUntil-os.time())/60) end
    local nxt
    if cur==0 then nxt=15 elseif cur<=15 then nxt=30 elseif cur<=30 then nxt=60 else nxt=0 end
    getgenv().ArkDNDUntil=(nxt>0) and (os.time()+nxt*60) or 0
    saveSettings()
    showToast("🔕 Do Not Disturb",nxt>0 and ("On for "..nxt.." min") or "Off",{color=C.accent,duration=2})
    return nxt
end

saveMessage=function(sender,text)
    local s=getgenv().ArkSaved
    text=tostring(text or "")
    if text=="" then return end
    for _,m in ipairs(s) do
        if m.sender==sender and m.text==text then
            showToast("⭐ Saved","Already in your saved list",{color=C.err,duration=2}); return
        end
    end
    table.insert(s,1,{sender=tostring(sender),text=text,t=os.time(),mine=(sender==LocalPlayer.Name)})
    while #s>50 do table.remove(s) end
    saveSettings()
    showToast("⭐ Saved","Message added to Saved (open ⭐ to see it)",{color=C.accent,duration=2})
end

