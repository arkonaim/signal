    local function writeTyping(isTyping)
        local uid = tostring(LocalPlayer.UserId)
        local now = tick()
        if isTyping and (now - lastTypingWrite) < 2.5 then return end
        if not isTyping and (now - lastTypingWrite) < 0.3 then return end
        lastTypingWrite = now
        local room = currentRoom
        task.spawn(function()
            local data = vaultRead("typing_" .. room) or {users = {}}
            if not data.users then data.users = {} end
            local now2 = os.time()
            for k, v in pairs(data.users) do
                if now2 - (v.ts or 0) > 6 then data.users[k] = nil end
            end
            if isTyping then
                data.users[uid] = {name = LocalPlayer.Name, ts = now2}
            else
                data.users[uid] = nil
            end
            vaultSave("typing_" .. room, data)
            if typingReadCache[room] then typingReadCache[room].ts = 0 end
        end)
    end

    local function getTypingUsers()
        local room = currentRoom
        local now = tick()
        local cache = typingReadCache[room]
        if not cache then return {} end
        if cache.data and (now - cache.ts) < 1.2 then return cache.data end
        local data = vaultRead("typing_" .. room)
        local result = {}
        if data and data.users then
            for uid, info in pairs(data.users) do
                if (os.time() - (info.ts or 0)) <= 5 then
                    local uidNum = tonumber(uid)
                    local displayName = (uidNum == LocalPlayer.UserId) and "You" or tostring(info.name or "Someone")
                    table.insert(result, {userId = uidNum, name = displayName})
                end
            end
        end
        cache.data = result
        cache.ts = now
        return result
    end

