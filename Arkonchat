local aiConversationId=nil
local aiHistory={}
local function loadAiState()
    if getgenv().AiPrivate==true then return end
    local uid=tostring(LocalPlayer.UserId)
    local convo=vaultRead("ai_convo_"..uid)
    if convo and convo.conversationId and convo.conversationId~="" then aiConversationId=convo.conversationId end
    local hist=vaultRead("ai_history_"..uid)
    if hist and hist.messages then aiHistory=hist.messages end
end
local function saveAiState()
    local trimmed={}; local startIdx=math.max(1,#aiHistory-49)
    for i=startIdx,#aiHistory do table.insert(trimmed,aiHistory[i]) end
    aiHistory=trimmed
    if getgenv().AiPrivate==true then return end
    local uid=tostring(LocalPlayer.UserId)
    if aiConversationId then vaultSave("ai_convo_"..uid,{conversationId=aiConversationId,savedAt=os.time()}) end
    vaultSave("ai_history_"..uid,{messages=aiHistory})
end
local function resetAiState()
    local uid=tostring(LocalPlayer.UserId)
    aiConversationId=nil; aiHistory={}
    vaultSave("ai_convo_"..uid,{conversationId="",resetAt=os.time()})
    vaultSave("ai_history_"..uid,{messages={}})
end
local function askAI(userMessage,isRetry)
    if isRetry==nil then isRetry=false end
    local body={message=userMessage}
    if aiConversationId and aiConversationId~="" then body.conversation_id=aiConversationId end
    local ok,res=pcall(httpRequest,{Url=AI_API_URL,Method="POST",Headers={["Content-Type"]="application/json",["x-api-key"]=AI_API_KEY},Body=HttpService:JSONEncode(body)})
    if not ok or not res then return nil,"Network error" end
    if res.StatusCode and res.StatusCode>=400 then return nil,"HTTP "..tostring(res.StatusCode) end
    if not res.Body or res.Body=="" then return nil,"Empty response" end
    local okD,data=pcall(function() return HttpService:JSONDecode(res.Body) end)
    if not okD or not data then return nil,"Invalid JSON" end
    if data.conversation_id and data.conversation_id~="" then aiConversationId=data.conversation_id; saveAiState() end
    if data.error then
        if not isRetry and aiConversationId then aiConversationId=nil; saveAiState(); return askAI(userMessage,true) end
        return nil,"API: "..tostring(data.error)
    end
    local reply=data.reply or data.message or data.content or data.text or data.response or data.answer or data.output or data.result
    if not reply or reply=="" then return nil,"No reply field" end
    return tostring(reply),nil
end

