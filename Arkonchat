task.spawn(function()
    local okBoot,errBoot=xpcall(function()
        showApology()

        local closeLoading = showLoading("Connecting to Arkonchat...")
        task.wait(1.5)

        local myProf=fetchProfileCloud(LocalPlayer.UserId,true)
        if myProf then
            getgenv().MyProfile.hide=(myProf.hidden==true)
            getgenv().MyProfile.private=(myProf.private==true)
            getgenv().MyProfile.hideJoin=(myProf.hideJoin==true)
            getgenv().MyProfile.hideGame=(myProf.hideGame==true)
            getgenv().MyProfile.hideCountry=(myProf.hideCountry==true)
            getgenv().MyProfile.hideLastSeen=(myProf.hideLastSeen==true)
            getgenv().MyProfile.blockDMs=(myProf.blockDMs==true)
            getgenv().MyProfile.customAvatarId=myProf.customAvatarId or ""
            getgenv().MyProfile.location=myProf.location or ""
            getgenv().MyProfile.title=myProf.title or ""
            getgenv().MyProfile.bio=myProf.bio or ""
        end

        -- load saved settings (animations + private AI + friends alerts + translate + v7.7/7.8)
        pcall(loadSettings)
        applyAccent(getgenv().ArkAccent)
        if not isDND() then getgenv().ArkDNDUntil=0 end

        local saved=loadKeyFromVault()
        if saved then
            local okV,msg=verifyKey(saved)
            if okV then
                closeLoading()
                _G.__startChat(saved)
            else
                closeLoading()
                deleteKeyFromVault()
                showKeyPrompt(tostring(msg))
            end
        else
            closeLoading()
            showKeyPrompt()
        end
    end,function(e) return tostring(e).."\n"..debug.traceback() end)
    if not okBoot then
        warn("[ARKONCHAT BOOT ERROR] "..tostring(errBoot))
        if setclipboard then pcall(setclipboard,tostring(errBoot)) end
    end
end)
