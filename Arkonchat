    {"tl","Filipino","🇵🇭"},
    {"vi","Tiếng Việt (Vietnamese)","🇻🇳"},
}
local transCache={}
local function translateText(text,target)
    text=tostring(text or "")
    if text=="" then return nil end
    local key=target.."|"..text
    if transCache[key] then return transCache[key][1],transCache[key][2] end
    local url="https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl="..target.."&dt=t&q="..HttpService:UrlEncode(text:sub(1,500))
    local ok,res=pcall(httpRequest,{Url=url,Method="GET",Headers={["User-Agent"]="Mozilla/5.0"}})
    if not ok or not res or not res.Body then return nil end
    if res.StatusCode and res.StatusCode>=400 then return nil end
    local okD,d=pcall(function() return HttpService:JSONDecode(res.Body) end)
    if not okD or type(d)~="table" or type(d[1])~="table" then return nil end
    local parts={}
    for _,seg in ipairs(d[1]) do
        if type(seg)=="table" and type(seg[1])=="string" then table.insert(parts,seg[1]) end
    end
    local out=table.concat(parts)
    if out=="" then return nil end
    local src=(type(d[3])=="string" and d[3]) or (type(d[2])=="string" and d[2]) or "?"
    transCache[key]={out,src}
    return out,src
end

