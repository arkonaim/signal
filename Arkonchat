local function lookupUserId(username)
    local ok,res=pcall(httpRequest,{
        Url="https://users.roblox.com/v1/usernames/users",Method="POST",
        Headers={["Content-Type"]="application/json"},
        Body=HttpService:JSONEncode({usernames={username},excludeBannedUsers=true})
    })
    if not ok or not res or not res.Body then return nil end
    local okD,d=pcall(function() return HttpService:JSONDecode(res.Body) end)
    if okD and d and d.data and d.data[1] then return d.data[1].id,d.data[1].name end
    return nil
end
